#include "/Engine/Private/Common.ush"

float4 SceneUVScaleBias;
float2 OutputInvSize;
int SampleCount;
int StepCount;
float Radius;

int DebugMode;

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;



float3 SafeNormalize(float3 value, float3 fallback)
{
	const float lengthSquared = dot(value, value);
	return lengthSquared > 1.0e-8 ? value * rsqrt(lengthSquared) : fallback;
}

float2 Hash2(inout float seed) {
	return frac(sin(float2(seed+=0.1,seed+=0.1))*float2(43758.5453123,22578.1459123));
}

float3 CosWeightedRandomHemisphereDirection( const float3 n, inout float seed ) {
	float2 r = Hash2(seed);
    
	float3  uu = normalize( cross( n, float3(0.0,1.0,1.0) ) );
	float3  vv = cross( uu, n );
	
	float ra = sqrt(r.y);
	float rx = ra*cos(6.2831*r.x); 
	float ry = ra*sin(6.2831*r.x);
	float rz = sqrt( 1.0-r.y );
	float3  rr = float3( rx*uu + ry*vv + rz*n );
    
	return normalize( rr );
}

float3 ReconstructTranslatedWorldPosition(float2 ViewportUV, float DeviceZ)
{
	const float2 screenPosition = ViewportUVToScreenPos(ViewportUV);
	const float sceneDepth = ConvertFromDeviceZ(DeviceZ);
	return mul(
		float4(GetScreenPositionForProjectionType(screenPosition, sceneDepth), sceneDepth, 1.0),
		View.ScreenToTranslatedWorld).xyz;
}


bool ProjectTranslatedWorldPosition(float3 position, out float2 viewportUV, out float raySceneDepth)
{
	const float4 clip = mul(float4(position, 1.0), View.TranslatedWorldToClip);
	raySceneDepth = clip.w;
	if (clip.w <= 0.0)
	{
		viewportUV = 0.0;
		return false;
	}
	viewportUV = ScreenPosToViewportUV(clip.xy / clip.w);
	return all(viewportUV > 0.0) && all(viewportUV < 1.0);
}

float3 ReconstructNormalFromDepth(float2 ViewportUV)
{
	const float2 pixel = OutputInvSize;
	const float2 halfPixel = pixel * 0.5;
	const float2 centerUV = clamp(ViewportUV, halfPixel, 1.0 - halfPixel);
	const float2 xUV = clamp(centerUV + float2(pixel.x, 0.0), halfPixel, 1.0 - halfPixel);
	const float2 yUV = clamp(centerUV + float2(0.0, pixel.y), halfPixel, 1.0 - halfPixel);

	const float centerZ = SceneDepthTexture.SampleLevel(
		SceneDepthSampler, centerUV * SceneUVScaleBias.xy + SceneUVScaleBias.zw, 0).r;
	const float xZ = SceneDepthTexture.SampleLevel(
		SceneDepthSampler, xUV * SceneUVScaleBias.xy + SceneUVScaleBias.zw, 0).r;
	const float yZ = SceneDepthTexture.SampleLevel(
		SceneDepthSampler, yUV * SceneUVScaleBias.xy + SceneUVScaleBias.zw, 0).r;

	const float3 center = ReconstructTranslatedWorldPosition(centerUV, centerZ);
	const float3 toCamera = SafeNormalize(View.TranslatedWorldCameraOrigin - center, float3(0.0, 0.0, 1.0));
	if (centerZ <= 0.0 || xZ <= 0.0 || yZ <= 0.0)
	{
		return toCamera;
	}

	// Reconstructing neighboring positions applies the inverse projection and transforms
	// the screen/depth height gradient into translated world space correctly.
	const float3 positionX = ReconstructTranslatedWorldPosition(xUV, xZ);
	const float3 positionY = ReconstructTranslatedWorldPosition(yUV, yZ);
	float3 normal = SafeNormalize(cross(positionY - center, positionX - center), toCamera);
	return dot(normal, toCamera) >= 0.0 ? normal : -normal;

}

float3 ClampLuminance(float3 color, float maxLum)
{
	float lum = Luminance(color);

	if (lum > maxLum)
		color *= maxLum / lum;

	return color;
}


void RayMarchPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	in FStereoPSInput StereoInput,
	out float4 OutColor : SV_Target0)
{
	const float2 UV = UVAndScreenPos.xy;
	const float2 sceneUV = UV * SceneUVScaleBias.xy + SceneUVScaleBias.zw;
	const float centerDeviceZ = SceneDepthTexture.SampleLevel(SceneDepthSampler, sceneUV, 0).r;
	if (centerDeviceZ <= 0.0)
	{
		OutColor = float4(0.0, 0.0, 0.0, 1.0e8);
		return;
	}
	const float3 centerPosition = ReconstructTranslatedWorldPosition(UV, centerDeviceZ);
	const float centerDepth = length(centerPosition - View.TranslatedWorldCameraOrigin);
	const float3 centerNormal = ReconstructNormalFromDepth(UV);
	if (DebugMode == 5)
	{
		OutColor = float4(centerNormal * 0.5 + 0.5, centerDepth);
		return;
	}

	const float2 pixelPosition = UV / OutputInvSize;
	float3 indirect = 0.0;
	float totalWeight = 0.0;
	
	float seed = pixelPosition.x + pixelPosition.y * 3.43121412313 + frac(1.12345314312*View.RealTime.x);
	
	[loop]
	for (int ray = 0; ray < SampleCount; ++ray)
	{
		const float3 rayDirection = CosWeightedRandomHemisphereDirection(centerNormal, seed);
		const float surfaceBias = max(1.0, Radius * 0.002);
		const float3 rayOrigin = centerPosition + centerNormal * surfaceBias;
		float previousDepthDelta = -1.0e8;
		float previousRayDistance = 0.0;
		[loop]
		for (int step = 1; step <= StepCount; ++step)
		{
			const float normalizedStep = float(step) / float(StepCount);
			const float rayDistance = Radius * normalizedStep * normalizedStep;
			const float3 rayPosition = rayOrigin + rayDirection * rayDistance;
			float2 rayViewportUV;
			float raySceneDepth;
			if (!ProjectTranslatedWorldPosition(rayPosition, rayViewportUV, raySceneDepth))
			{
				break;
			}

			const float2 raySceneUV = rayViewportUV * SceneUVScaleBias.xy + SceneUVScaleBias.zw;
			const float sampleDeviceZ = SceneDepthTexture.SampleLevel(SceneDepthSampler, raySceneUV, 0).r;
			if (sampleDeviceZ <= 0.0)
			{
				continue;
			}
			const float sceneDepth = ConvertFromDeviceZ(sampleDeviceZ);
			const float depthDelta = raySceneDepth - sceneDepth;
			const float stepLength = rayDistance - previousRayDistance;
			const float thickness = max(sceneDepth * 0.02, stepLength * 1.5);
			const bool crossedSurface = previousDepthDelta < 0.0 && depthDelta >= 0.0;
			if (depthDelta >= 0.0 && (depthDelta < thickness || crossedSurface))
			{
				const float3 hitNormal = ReconstructNormalFromDepth(rayViewportUV);
				const float receiverCosine = saturate(dot(centerNormal, rayDirection));
				const float emitterCosine = saturate(dot(hitNormal, -rayDirection));
				const float distanceWeight = 1.0 / (1.0 + rayDistance * rayDistance * 0.00001);
				float weight = receiverCosine * emitterCosine * distanceWeight;

				const float3 radiance = SceneColorTexture.SampleLevel(SceneColorSampler, raySceneUV, 0).rgb;
				
				float3 correctedRadiance=ClampLuminance(radiance,1.0);
				
				indirect += max(correctedRadiance, 0.0) * weight;
				
				totalWeight += weight;
				break;
			}

			previousDepthDelta = depthDelta;
			previousRayDistance = rayDistance;
		}
	}

	indirect = totalWeight > 0.0 ? indirect / totalWeight : 0.0;
	OutColor = float4(indirect, centerDepth);
}